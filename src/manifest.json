{
  "manifest_version": 3,
  "name": "FB Optimizer",
  "version": "1.1.0",
  "description": "Removes Reels, ads, Stories, suggested creators and trackers from Facebook for a faster, cleaner experience. By Benoît (BSM) Saint-Moulin - bsm3d.com",
  "author": "Benoît (BSM) Saint-Moulin - https://www.bsm3d.com",
  "homepage_url": "https://www.bsm3d.com",
  "browser_specific_settings": {
    "gecko": {
      "id": "fb-optimizer@bsm3d.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fb-trackers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "fb-optimizer.css"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FB Optimizer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
